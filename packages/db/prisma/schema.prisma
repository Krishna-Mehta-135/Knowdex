generator client {
  provider = "prisma-client-js"
  output   = "../client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                   @id @default(uuid())
  username                 String                   @unique
  email                    String                   @unique
  password                 String?
  googleId                 String?                  @unique
  githubId                 String?                  @unique
  createdAt                DateTime                 @default(now())
  contents                 Content[]
  links                    Link[]
  shares                   Share[]
  ownedWorkspaces          Workspace[]              @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]        @relation("WorkspaceMembershipUser")
  workspaceJoinRequests    WorkspaceJoinRequest[]   @relation("WorkspaceJoinRequester")
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  contents Content[]
}

model Content {
  id          String     @id @default(uuid())
  title       String
  link        String
  type        String // "link", "video", "document", "tweet", "tag"
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  tags        Tag[]
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  folderPath  String     @default("")
  isPublic    Boolean    @default(false)
  /// Set when this note is a row of a NoteDatabase; `props` holds its property values.
  databaseId  String?
  props       Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([databaseId])
}

model Workspace {
  id           String                   @id @default(uuid())
  name         String
  slug         String                   @unique
  ownerId      String
  owner        User                     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic     Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  contents     Content[]
  members      WorkspaceMember[]
  joinRequests WorkspaceJoinRequest[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation("WorkspaceMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model WorkspaceJoinRequest {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester   User      @relation("WorkspaceJoinRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Link {
  id     String @id @default(uuid())
  link   String
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Share {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  shareLink  String    @unique
  expiry     DateTime?
  isPublic   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Document {
  id        String         @id
  state     Bytes
  updatedAt DateTime       @updatedAt
  outgoing  DocumentLink[] @relation("FromDoc")
  incoming  DocumentLink[] @relation("ToDoc")
}

/**
 * Tracks wiki-style [[Document Title]] backlinks between documents.
 * Updated whenever the editor detects link changes in content.
 */
model DocumentLink {
  fromDocId  String
  toDocId    String
  fromDoc    Document @relation("FromDoc", fields: [fromDocId], references: [id], onDelete: Cascade)
  toDoc      Document @relation("ToDoc", fields: [toDocId], references: [id], onDelete: Cascade)

  @@id([fromDocId, toDocId])
  @@index([toDocId])
}

/**
 * Semantic index: one row per text chunk of a document or attachment.
 * Embeddings are stored as float arrays (no pgvector extension required) and
 * compared in-process; a workspace holds at most a few thousand chunks.
 */
model DocChunk {
  id          String   @id @default(uuid())
  /** Content id for notes, Attachment id for files. */
  sourceId    String
  sourceType  String   @default("document") // "document" | "attachment"
  workspaceId String
  idx         Int
  text        String
  embedding   Float[]
  embedder    String   @default("local-hash-v1")
  createdAt   DateTime @default(now())

  @@index([sourceId])
  @@index([workspaceId])
}

/** Tracks what was last indexed so the background sweep only re-embeds changes. */
model DocIndexState {
  sourceId  String   @id
  hash      String
  embedder  String
  indexedAt DateTime @default(now())
}

/** Files (PDF, images, ...) uploaded into a note. Stored inline in Postgres. */
model Attachment {
  id            String   @id @default(uuid())
  docId         String?
  workspaceId   String
  userId        String
  name          String
  mime          String
  size          Int
  data          Bytes
  extractedText String   @default("")
  createdAt     DateTime @default(now())

  @@index([docId])
  @@index([workspaceId])
}

/** Point-in-time snapshots of a note's Y.Doc for history / restore. */
model DocVersion {
  id        String   @id @default(uuid())
  docId     String
  state     Bytes
  wordCount Int      @default(0)
  preview   String   @default("")
  /// "auto" (background) | "manual" (checkpoint / before-restore)
  kind      String   @default("auto")
  createdAt DateTime @default(now())

  @@index([docId, createdAt])
}

/**
 * A Notion-style database: rows are ordinary notes (Content.databaseId) whose
 * property values live in Content.props, keyed by property id.
 */
model NoteDatabase {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  icon        String   @default("")
  /// [{ id, name, type, options?: [{ id, name, color }] }]
  schema      Json     @default("[]")
  /// [{ id, name, type: "table" | "board", groupBy?, sort?, hidden? }]
  views       Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}
