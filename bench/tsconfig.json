{
  "extends": "../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@repo/*": ["../packages/*/src/index.ts"],
      "@repo/types": ["../packages/types/src/index.ts"],
      "@repo/crdt": ["../packages/crdt/src/index.ts"]
    }
  },
  "include": [
